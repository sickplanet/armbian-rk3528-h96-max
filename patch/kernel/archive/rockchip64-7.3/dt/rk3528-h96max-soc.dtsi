/* RK3528 blocks not yet described by the native stable tree. */

#include "rk3528.dtsi"
#include <dt-bindings/soc/rockchip,vop2.h>

&{/soc} {
	vop: vop@ff840000 {
		compatible = "rockchip,rk3528-vop";
		reg = <0x0 0xff840000 0x0 0x3000>;
		reg-names = "vop";
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_VOP>,
			 <&cru HCLK_VOP>,
			 <&cru DCLK_VOP0>;
		clock-names = "aclk", "hclk", "dclk_vp0";
		assigned-clocks = <&cru DCLK_VOP0>;
		assigned-clock-parents = <&hdmiphy>;
		power-domains = <&power RK3528_PD_VO>;
		status = "disabled";

		vop_out: ports {
			#address-cells = <1>;
			#size-cells = <0>;

			vp0: port@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
					reg = <ROCKCHIP_VOP2_EP_HDMI0>;
					remote-endpoint = <&hdmi_in_vp0>;
				};
			};
		};
	};

	hdmi: hdmi@ff8d0000 {
		compatible = "rockchip,rk3528-dw-hdmi";
		reg = <0x0 0xff8d0000 0x0 0x20000>;
		interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru PCLK_HDMI>,
			 <&cru CLK_SFR_HDMI>,
			 <&cru CLK_CEC_HDMI>;
		clock-names = "iahb", "isfr", "cec";
		phys = <&hdmiphy>;
		phy-names = "hdmi";
		power-domains = <&power RK3528_PD_VO>;
		reg-io-width = <4>;
		rockchip,grf = <&vo_grf>;
		#sound-dai-cells = <0>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi_in: port@0 {
				reg = <0>;

				hdmi_in_vp0: endpoint {
					remote-endpoint = <&vp0_out_hdmi>;
				};
			};

			hdmi_out: port@1 {
				reg = <1>;
			};
		};
	};

	hdmiphy: phy@ffe00000 {
		compatible = "rockchip,rk3528-hdmi-phy";
		reg = <0x0 0xffe00000 0x0 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru PCLK_HDMIPHY>, <&xin24m>;
		clock-names = "sysclk", "refoclk";
		clock-output-names = "clk_hdmiphy_pixel_io";
		#clock-cells = <0>;
		#phy-cells = <0>;
		power-domains = <&power RK3528_PD_VO>;
		status = "disabled";
	};

};
