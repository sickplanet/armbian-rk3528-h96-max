+static void vop2_vp_disable(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+
+	if (!vp->enabled)
+		return;
+
+	if (vp->dclk_src)
+		clk_set_parent(vp->dclk, vp->dclk_src);
+	clk_disable_unprepare(vp->dclk);
+	vp->enabled = false;
+
+	if (!--vop2->enable_count)
+		vop2_disable(vop2);
 }
 
