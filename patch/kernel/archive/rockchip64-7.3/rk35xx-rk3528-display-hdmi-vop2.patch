+static void inno_hdmi_phy_rk3528_power_off(struct inno_hdmi_phy *inno)
+{
+	/* Also invalidate direct clock-provider failures, outside phy_power_on(). */
+	inno->tmdsclock = 0;
+
+	/* Power off driver */
+	inno_write(inno, 0xb2, 0);
+	/* Power off serializer */
+	inno_write(inno, 0xbe, 0);
+	/* Power off post PLL */
+	inno_update_bits(inno, 0xaa, RK3328_POST_PLL_POWER_DOWN,
+			 RK3328_POST_PLL_POWER_DOWN);
+	/* Power off rxsense detection circuit */
+	inno_write(inno, 0xcc, 0);
+	/* Power off band gap */
+	inno_update_bits(inno, 0xb0, RK3328_BANDGAP_ENABLE, 0);
+	/* Disable PHY IRQ */
+	inno_write(inno, 0x05, 0);
+	inno_write(inno, 0x07, 0);
+}
+
+static int inno_hdmi_phy_rk3528_init(struct inno_hdmi_phy *inno)
+{
+	/*
+	 * Use phy internal register control
+	 * rxsense/poweron/pllpd/pdataen signal.
+	 */
+	inno_write(inno, 0x02, 0x81);
+
+	inno->chip_version = INNO_HDMI_PHY_VERSION_RK3528;
+
+	/* Start from a known state whatever the bootloader left behind */
+	inno_hdmi_phy_rk3528_power_off(inno);
+
+	return 0;
+}
+
+static int
+inno_hdmi_phy_rk3528_power_on(struct inno_hdmi_phy *inno,
+			      const struct post_pll_config *cfg,
+			      const struct phy_config *phy_cfg)
+{
+	u64 temp;
+	u32 v;
+	int ret;
+
+	/* Configure post PLL */
+	inno_write(inno, 0xab, cfg->prediv);
+	if (cfg->postdiv == 1) {
+		inno_write(inno, 0xad, 0x8);
+		inno_write(inno, 0xaa, 0x2);
+	} else {
+		inno_write(inno, 0xad, (cfg->postdiv / 2) - 1);
+		inno_write(inno, 0xaa, 0xe);
+	}
+	inno_write(inno, 0xac, cfg->fbdiv & 0xff);
+	inno_update_bits(inno, 0xad, BIT(4), (cfg->fbdiv >> 8) & BIT(0) ? BIT(4) : 0);
+
+	/* Current bias for clock and data lanes */
+	inno_write(inno, 0xbf, phy_cfg->regs[0] << 4 | phy_cfg->regs[1]);
+	inno_write(inno, 0xc0, phy_cfg->regs[1] << 4 | phy_cfg->regs[1]);
+
+	/* Output voltage */
+	inno_write(inno, 0xb5, phy_cfg->regs[2]);
+	inno_write(inno, 0xb6, phy_cfg->regs[3]);
+	inno_write(inno, 0xb7, phy_cfg->regs[3]);
+	inno_write(inno, 0xb8, phy_cfg->regs[3]);
+
+	/* Pre-emphasis */
+	inno_write(inno, 0xbb, phy_cfg->regs[4]);
+	inno_write(inno, 0xbc, phy_cfg->regs[4]);
+	inno_write(inno, 0xbd, phy_cfg->regs[4]);
+
+	/* Enable LDO */
+	inno_write(inno, 0xb4, 0x7);
+	/* Enable serializer */
+	inno_write(inno, 0xbe, 0x70);
+	/* Enable TMDS driver */
+	inno_write(inno, 0xb2, 0x0f);
+
+	/* Wait for post PLL lock */
+	ret = inno_poll(inno, 0xaf, v, v & RK3328_POST_PLL_LOCK_STATUS,
+			1000, 10000);
+	if (ret) {
+		dev_err(inno->dev, "Post-PLL locking failed\n");
+		return ret;
+	}
+
+	/* Termination resistance */
+	inno_write(inno, 0xc7, phy_cfg->regs[5]);
+	inno_write(inno, 0xc5, phy_cfg->regs[6]);
+	inno_write(inno, 0xc8, phy_cfg->regs[7]);
+	inno_write(inno, 0xc9, phy_cfg->regs[8]);
+	inno_write(inno, 0xca, phy_cfg->regs[8]);
+	inno_write(inno, 0xcb, phy_cfg->regs[8]);
+	inno_update_bits(inno, 0xb0, BIT(1), phy_cfg->regs[9] ? BIT(1) : 0);
+
+	/* TMDS sync detection counter length */
+	temp = 47520000000ULL;
+	do_div(temp, inno->tmdsclock);
+	inno_write(inno, 0xd8, (temp >> 8) & 0xff);
+	inno_write(inno, 0xd9, temp & 0xff);
+
+	/* Power up post PLL, band gap and TMDS driver */
+	inno_update_bits(inno, 0xaa, RK3328_POST_PLL_POWER_DOWN, 0);
+	inno_update_bits(inno, 0xb0, RK3328_BANDGAP_ENABLE,
+			 RK3328_BANDGAP_ENABLE);
+	inno_write(inno, 0xb2, 0x0f);
+
+	if (phy_cfg->tmdsclock > 340000000)
+		msleep(100);
+
+	/* Pulse pdata_en */
+	inno_update_bits(inno, 0x02, RK3328_PDATA_EN, 0);
+	inno_update_bits(inno, 0x02, RK3328_PDATA_EN, RK3328_PDATA_EN);
+
+	/* Enable PHY IRQ */
+	inno_write(inno, 0x05, 0x22);
+	inno_write(inno, 0x07, 0x22);
+	inno_write(inno, 0xcc, 0x0f);
+
+	return 0;
+}
+
