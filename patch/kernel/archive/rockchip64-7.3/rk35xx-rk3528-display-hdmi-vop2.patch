+static enum drm_mode_status
+dw_hdmi_rk3528_mode_valid(struct dw_hdmi *dw_hdmi, void *data,
+			 const struct drm_display_info *info,
+			 const struct drm_display_mode *mode)
+{
+	enum drm_mode_status status;
+
+	status = dw_hdmi_rockchip_mode_valid(dw_hdmi, data, info, mode);
+	if (status != MODE_OK)
+		return status;
+
+	/* This encoder currently transmits RGB888, so TMDS equals pixel rate. */
+	if (info->max_tmds_clock && mode->clock > info->max_tmds_clock)
+		return MODE_CLOCK_HIGH;
+
+	/* High TMDS rates require scrambling and a working SCDC link. */
+	if (mode->clock > 340000 &&
