+static int vop2_vp_enable(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	int ret;
+
+	if (vp->enabled)
+		return 0;
+
+	ret = clk_prepare_enable(vp->dclk);
+	if (ret)
+		return ret;
+
+	if (!vop2->enable_count) {
+		ret = vop2_enable(vop2);
+		if (ret) {
+			clk_disable_unprepare(vp->dclk);
+			return ret;
+		}
+	}
+
+	vop2->enable_count++;
+	vp->enabled = true;
+	return 0;
+}
