+static void inno_hdmi_phy_rk3528_power_off(struct inno_hdmi_phy *inno);
+
+static int inno_hdmi_phy_rk3528_clk_set_rate(struct clk_hw *hw,
+					     unsigned long rate,
+					     unsigned long parent_rate)
+{
+	struct inno_hdmi_phy *inno = to_inno_hdmi_phy(hw);
+	int ret;
+
+	/*
+	 * The pre-PLL only locks with the bandgap and the rxsense detection
+	 * powered, which power_on() would otherwise do after the rate change.
+	 */
+	inno_update_bits(inno, 0xb0, RK3328_BANDGAP_ENABLE,
+			 RK3328_BANDGAP_ENABLE);
+	inno_write(inno, 0xcc, 0x0f);
+
+	/* A lost lock must not take the cached-rate shortcut. */
+	if (!(inno_read(inno, 0xa9) & RK3328_PRE_PLL_LOCK_STATUS))
+		inno->tmdsclock = 0;
+
+	ret = inno_hdmi_phy_rk3328_clk_set_rate(hw, rate, parent_rate);
+	if (ret)
+		inno_hdmi_phy_rk3528_power_off(inno);
+
+	return ret;
+}
+
+/* Same pre-PLL as RK3328, just a different power-up sequence */
