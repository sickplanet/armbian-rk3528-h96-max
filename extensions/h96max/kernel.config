# SPDX-License-Identifier: MIT

# RK3528 display pipeline
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=m
CONFIG_ROCKCHIP_PM_DOMAINS=y

# RK3528 thermal support
CONFIG_ROCKCHIP_THERMAL=y

# H96 PWM regulators and SD voltage switching
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR_FIXED=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y

# Display memory
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# RK3528 analog, HDMI and optical audio
CONFIG_SND_SOC_ROCKCHIP_SAI=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_RK3528=m
CONFIG_SND_SOC_SPDIF=m
CONFIG_SND_SIMPLE_CARD=m

# Keep the front panel on the boot message when its driver loads.
CONFIG_PANEL_CHANGE_MESSAGE=y
CONFIG_PANEL_BOOT_MESSAGE="boot"
